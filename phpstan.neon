includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    level: max

    paths:
        - app
        - bootstrap
        - config
        - database
        - public
        - routes
