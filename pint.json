{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "declare_strict_types": true,
        "final_class": true,
        "psr_autoloading": {
            "dir": "app"
        },
        "single_line_empty_body": true,
        "single_trait_insert_per_statement": true,
        "no_extra_blank_lines": {
            "tokens": [
                "extra",
                "throw",
                "use",
                "use_trait"
            ]
        }
    }
}
